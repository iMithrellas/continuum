#!/usr/bin/env bash
# Bootstrap a separate admin-profile client identity and optionally grant it admin.
# The grant is never automatic: pass --grant and confirm with --yes.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HOST="${CONTINUUM_HOST:-http://127.0.0.1:3000}"
DB="${CONTINUUM_DB:-continuum}"
GODOT="${GODOT:-godot}"
STDB="${CONTINUUM_STDB:-}"
PUBLISHER_HOST="${CONTINUUM_PUBLISHER_HOST:-http://127.0.0.1:3000}"
GRANT=0
YES=0
for argument in "$@"; do
    case "$argument" in
        --grant) GRANT=1 ;;
        --yes) YES=1 ;;
        --stdb-host=*) HOST="${argument#*=}" ;;
        --stdb-db=*) DB="${argument#*=}" ;;
        *) printf 'usage: %s [--grant --yes] [--stdb-host=URL] [--stdb-db=NAME]\n' "$0" >&2; exit 2 ;;
    esac
done

if [[ "$GRANT" == 1 && "$HOST" != "$PUBLISHER_HOST" ]]; then
    printf 'refusing publisher grant: publisher targets %s, got %s\n' "$PUBLISHER_HOST" "$HOST" >&2
    exit 2
fi

output="$($GODOT --headless --path "$ROOT/client/godot" --scene res://scenes/admin_bootstrap.tscn -- \
    --stdb-host="$HOST" --stdb-db="$DB" --profile=admin)"
identity="$(printf '%s\n' "$output" | awk -F= '$1 == "CLIENT_IDENTITY" { print $2; exit }')"
[[ -n "$identity" ]] || { printf 'admin launcher: bootstrap did not return an identity\n' >&2; exit 1; }
printf 'admin client identity: %s\n' "$identity"
printf 'admin profile: %s\n' "$DB"

if [[ "$GRANT" == 1 ]]; then
    if [[ "$YES" != 1 ]]; then
        read -r -p "Grant admin to this distinct identity on '$DB'? [y/N] " answer
        [[ "$answer" == "y" || "$answer" == "Y" ]] || { printf 'grant cancelled\n'; exit 0; }
    fi
    printf 'granting admin through the existing publisher CLI...\n'
    if [[ -n "$STDB" ]]; then
        "$STDB" call "$DB" grant_admin "\"$identity\"" >/dev/null
    else
        docker compose exec -T spacetimedb spacetime call "$DB" grant_admin "\"$identity\"" </dev/null >/dev/null
    fi
fi

"$GODOT" --headless --path "$ROOT/client/godot" --script res://tools/access_probe.gd -- \
    --stdb-host="$HOST" --stdb-db="$DB" --profile=admin --expected=Admin >/dev/null
printf 'admin profile verified through the sender-scoped role view\n'
exec "$GODOT" --path "$ROOT/client/godot" -- \
    --stdb-host="$HOST" --stdb-db="$DB" --profile=admin
