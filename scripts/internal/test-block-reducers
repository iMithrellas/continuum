#!/usr/bin/env bash
# Runtime coverage for rectangular block reducers.
#
# This intentionally owns a uniquely named container, two uniquely named volumes,
# and a dynamically assigned host port. It never uses the repository compose stack.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
NAME="continuum-blocks-it-${USER:-user}-$$"
DB="continuum-blocks-it-$$"
DATA="${NAME}-data"
CONFIG="${NAME}-config"
CONTAINER=""

cleanup() {
    if [[ -n "$CONTAINER" ]]; then
        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    fi
    docker volume rm "$DATA" "$CONFIG" >/dev/null 2>&1 || true
}
trap cleanup EXIT

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    exit 1
}

assert_eq() {
    [[ "$1" == "$2" ]] || fail "$3 (expected '$2', got '$1')"
}

assert_call_fails() {
    if call "$@" >/tmp/continuum-blocks-it-error-$$ 2>&1; then
        rm -f "/tmp/continuum-blocks-it-error-$$"
        fail "expected reducer call to fail: $*"
    fi
    rm -f "/tmp/continuum-blocks-it-error-$$"
}

call() {
    docker exec "$CONTAINER" spacetime call -s http://127.0.0.1:3000 "$DB" "$@"
}

sql() {
    docker exec "$CONTAINER" spacetime sql --format json -s http://127.0.0.1:3000 "$DB" "$1"
}

scalar() {
    sql "$1" | jq -r '[.. | numbers][0]'
}

kind_count() {
    local ordinal
    case "$2" in
        farm) ordinal=4 ;;
        mine) ordinal=5 ;;
        *) fail "unknown tile kind in test: $2" ;;
    esac
    sql "$1" | jq --argjson ordinal "$ordinal" '[.[] | .rows[] | select(.[2][0] == $ordinal)] | length'
}

order_count() {
    local ordinal
    case "$2" in
        logging) ordinal=1 ;;
        hunting) ordinal=3 ;;
        *) fail "unknown work kind in test: $2" ;;
    esac
    sql "$1" | jq --argjson ordinal "$ordinal" --argjson priority "$3" \
        '[.[] | .rows[] | select(.[1][0] == $ordinal and .[2] == $priority and .[3] == false)] | length'
}

mining_orders() {
    sql 'SELECT tile_id, work, priority, enabled FROM work_order' \
        | jq '[.[] | .rows[] | select(.[1][0] == 2)] | sort_by(.[0])'
}

count_events() {
    scalar 'SELECT COUNT(*) AS count FROM event_log'
}

matching_events() {
    sql 'SELECT message FROM event_log' | jq --arg needle "$1" \
        '[.[] | .rows[] | select(.[0] | contains($needle))] | length'
}

printf '==> building wasm\n'
cargo build --manifest-path "$ROOT/backend/spacetimedb/Cargo.toml" \
    --release --target wasm32-unknown-unknown >/dev/null

docker volume create "$DATA" >/dev/null
docker volume create "$CONFIG" >/dev/null
CONTAINER="$NAME"
docker run --rm --user root --entrypoint sh \
    -v "$DATA:/home/spacetime/.local/share/spacetime" \
    -v "$CONFIG:/home/spacetime/.config/spacetime" \
    clockworklabs/spacetime:v2.10.0 -c \
    'chown -R 1000:1000 /home/spacetime/.local/share/spacetime /home/spacetime/.config/spacetime'
printf '==> starting private container %s\n' "$CONTAINER"
docker run -d --name "$CONTAINER" -p 127.0.0.1::3000 \
    -v "$DATA:/home/spacetime/.local/share/spacetime" \
    -v "$CONFIG:/home/spacetime/.config/spacetime" \
    -v "$ROOT/backend/spacetimedb:/project:ro" \
    clockworklabs/spacetime:v2.10.0 start --listen-addr 0.0.0.0:3000 >/dev/null

for _ in {1..30}; do
    if docker exec "$CONTAINER" spacetime server ping local >/dev/null 2>&1; then
        break
    fi
    sleep 1
done
docker exec "$CONTAINER" spacetime server ping local >/dev/null

printf '==> authenticating and publishing private database %s\n' "$DB"
docker exec "$CONTAINER" spacetime login --no-browser \
    --auth-host http://127.0.0.1:3000 </dev/null >/dev/null 2>&1 || true
docker exec "$CONTAINER" spacetime publish --yes --delete-data=always \
    --server http://127.0.0.1:3000 -b /project/target/wasm32-unknown-unknown/release/continuum_module.wasm "$DB" \
    >/tmp/continuum-blocks-it-publish-$$ 2>&1 || {
        cat /tmp/continuum-blocks-it-publish-$$ >&2
        exit 1
    }
rm -f "/tmp/continuum-blocks-it-publish-$$"
ORIGIN="$(python3 "$ROOT/scripts/internal/world_ready.py" --starter-origin -- \
    docker exec "$CONTAINER" spacetime sql --format json --server http://127.0.0.1:3000 "$DB")"
read -r STARTER_X STARTER_Y <<< "$ORIGIN"
# Translate fixture positions, never tile IDs: the original 576 IDs survive
# centered founding unchanged and are not x + y * world_width.
for offset in 0 1 2 3 16 20 22 23; do
    printf -v "X$offset" '%d' "$((STARTER_X + offset))"
    printf -v "Y$offset" '%d' "$((STARTER_Y + offset))"
done

printf '==> obtaining deterministic wood reserve\n'
call set_time_scale 100000 >/dev/null
for _ in {1..30}; do
    wood="$(scalar 'SELECT wood FROM colony')"
    if awk "BEGIN { exit !($wood >= 500) }"; then
        break
    fi
    sleep 1
done
wood_before="$(scalar 'SELECT wood FROM colony')"
awk "BEGIN { exit !($wood_before >= 500) }" || fail "simulation did not produce enough wood"
call set_time_scale 0 >/dev/null

printf '==> exact reversed 2x2 build and safety checks\n'
events_before="$(matching_events 'Built ')"
colonists_before="$(scalar 'SELECT COUNT(*) AS count FROM colonist')"
stacks_before="$(scalar 'SELECT COUNT(*) AS count FROM item_stack')"
food_before="$(scalar 'SELECT food FROM colony')"
stone_before="$(scalar 'SELECT stone FROM colony')"
meat_before="$(scalar 'SELECT meat FROM colony')"
HOST_PORT="$(docker port "$CONTAINER" 3000/tcp | awk -F: '{print $NF}')"
python3 - "http://127.0.0.1:$HOST_PORT" "$DB" "$CONTAINER" "$STARTER_X" "$STARTER_Y" <<'PY'
import json, subprocess, sys, urllib.error, urllib.request
host, db, container = sys.argv[1:4]
starter_x, starter_y = map(int, sys.argv[4:])
with urllib.request.urlopen(urllib.request.Request(host + "/v1/identity", method="POST"), timeout=10) as response:
    player = json.load(response)
def player_call(args, denied=False):
    request = urllib.request.Request(host + f"/v1/database/{db}/call/build_tile_block",
        json.dumps(args).encode(), {"Authorization": "Bearer " + player["token"],
                                   "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=30):
            assert not denied, "explicit Viewer build unexpectedly succeeded"
    except urllib.error.HTTPError as error:
        assert denied and error.code == 530 and error.read().decode().strip() == \
            "caller lacks the required colony role", "not an exact build reducer authorization denial"
def snapshot():
    result = []
    for table in ("config", "colony", "tile", "colonist", "item_stack", "work_order",
                  "terrain_chunk", "excavation_designation", "event_log", "membership"):
        raw = subprocess.check_output(["docker", "exec", container, "spacetime", "sql",
            "--format", "json", "--server", "http://127.0.0.1:3000", db, "SELECT * FROM " + table])
        value = json.loads(raw)
        result.append([(entry["schema"], sorted(entry["rows"],
            key=lambda row: json.dumps(row, sort_keys=True))) for entry in value])
    return result
player_call([starter_x + 1, starter_y + 1, starter_x, starter_y, {"farm": []}])
subprocess.run(["docker", "exec", container, "spacetime", "call", "--server",
    "http://127.0.0.1:3000", db, "set_operator", json.dumps(player["identity"]), "false"], check=True,
    stdout=subprocess.DEVNULL)
before = snapshot()
player_call([starter_x, starter_y + 2, starter_x, starter_y + 2, {"farm": []}], denied=True)
assert snapshot() == before, "denied build changed durable state"
print("BLOCK_AUTHORIZATION_PASS default Operator builds; explicit Viewer actual build_tile_block denied: HTTP 530 exact role error; ten tables unchanged")
PY
wood_after="$(scalar 'SELECT wood FROM colony')"
assert_eq "$(awk "BEGIN { printf \"%.0f\", $wood_before - $wood_after }")" "80" "2x2 build cost"
assert_eq "$(kind_count "SELECT x, y, kind FROM tile WHERE x >= $X0 AND x <= $X1 AND y >= $Y0 AND y <= $Y1" farm)" "4" "2x2 reversed build tiles"
assert_eq "$(matching_events 'Built ')" "$((events_before + 1))" "build audit count"
assert_eq "$(scalar 'SELECT COUNT(*) AS count FROM colonist')" "$colonists_before" "colonist preservation"
assert_eq "$(scalar 'SELECT COUNT(*) AS count FROM item_stack')" "$stacks_before" "pile preservation"
assert_eq "$(scalar 'SELECT food FROM colony')" "$food_before" "food preservation"
assert_eq "$(scalar 'SELECT stone FROM colony')" "$stone_before" "stone preservation"
assert_eq "$(scalar 'SELECT meat FROM colony')" "$meat_before" "meat preservation"

events_before="$(matching_events 'Built ')"
wood_before_failed_build="$(scalar 'SELECT wood FROM colony')"
assert_call_fails build_tile_block "$X2" "$Y2" "$X3" "$Y3" '{"mine":{}}'
assert_eq "$(matching_events 'Built ')" "$events_before" "occupied build has no audit"
assert_eq "$(scalar 'SELECT wood FROM colony')" "$wood_before_failed_build" "occupied build does not spend wood"
world_width="$(scalar 'SELECT width FROM world_geometry')"
assert_call_fails build_tile_block "$((world_width - 1))" "$Y23" "$world_width" "$Y23" '{"storage":{}}'
assert_call_fails build_tile_block "$X0" "$Y0" "$X0" "$Y0" '{"sleep":{}}'
assert_eq "$(kind_count "SELECT x, y, kind FROM tile WHERE x >= $X2 AND x <= $X3 AND y >= $Y2 AND y <= $Y3" mine)" "0" "failed build rollback"

printf '==> enable block, no-op, empty skipping, and empty rejection\n'
events_before="$(matching_events 'Tile block ')"
call set_tile_block_enabled "$X1" "$Y1" "$X0" "$Y0" false >/dev/null
assert_eq "$(scalar "SELECT COUNT(*) AS count FROM tile WHERE x >= $X0 AND x <= $X1 AND y >= $Y0 AND y <= $Y1 AND enabled = false")" "4" "block disable"
assert_eq "$(matching_events 'Tile block ')" "$((events_before + 1))" "disable audit count"
call set_tile_block_enabled "$X0" "$Y0" "$X1" "$Y1" false >/dev/null
assert_eq "$(matching_events 'Tile block ')" "$((events_before + 1))" "disable no-op audit count"
events_before="$(matching_events 'Tile block ')"
call set_tile_block_enabled "$X0" "$Y0" "$X2" "$Y2" true >/dev/null
assert_eq "$(matching_events 'Tile block ')" "$((events_before + 1))" "empty skip audit count"
assert_call_fails set_tile_block_enabled "$X22" "$Y22" "$X23" "$Y23" true
assert_eq "$(matching_events 'Tile block ')" "$((events_before + 1))" "all-empty rejection audit count"

printf '==> Forest dual orders and unrelated order preservation\n'
mining_before="$(mining_orders)"
call set_block_work_order "$X16" "$Y20" "$X20" "$Y16" '{"logging":{}}' 1 false >/dev/null
call set_block_work_order "$X16" "$Y16" "$X20" "$Y20" '{"hunting":{}}' 3 false >/dev/null
assert_eq "$(order_count 'SELECT tile_id, work, priority, enabled FROM work_order' logging 1)" "25" "logging block orders"
assert_eq "$(order_count 'SELECT tile_id, work, priority, enabled FROM work_order' hunting 3)" "25" "hunting block orders"
assert_eq "$(mining_orders)" "$mining_before" "unrelated mining orders"
work_events_before="$(matching_events 'Work order block ')"
call set_block_work_order "$X16" "$Y20" "$X20" "$Y16" '{"logging":{}}' 1 false >/dev/null
assert_eq "$(matching_events 'Work order block ')" "$work_events_before" "work-order no-op audit count"
assert_call_fails set_block_work_order "$X16" "$Y16" "$X20" "$Y20" '{"logging":{}}' 0 true
assert_call_fails set_block_work_order "$X0" "$Y0" "$X1" "$Y1" '{"mining":{}}' 2 true

printf 'PASS: isolated block reducer integration coverage\n'
printf '    container=%s database=%s\n' "$CONTAINER" "$DB"
printf '    cleanup=automatic\n'
