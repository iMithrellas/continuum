#!/usr/bin/env bash
# Verifies failure cleanup for one uniquely named private test allocation.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
NAME="continuum-access-it-cleanup-${USER:-user}-$$"
if CONTINUUM_ACCESS_NAME="$NAME" CONTINUUM_ACCESS_INJECT_FAILURE=after-start "$ROOT/scripts/internal/test-access" >/tmp/continuum-access-cleanup-$$.log 2>&1; then
    printf 'FAIL: injected access test unexpectedly passed\n' >&2
    exit 1
fi
if docker ps -a --format '{{.Names}}' | awk -v name="$NAME" '$0 == name {found=1} END {exit found}'; then :; else printf 'FAIL: cleanup left container %s\n' "$NAME" >&2; exit 1; fi
if docker volume ls --format '{{.Name}}' | awk -v data="$NAME-data" -v config="$NAME-config" '$0 == data || $0 == config {found=1} END {exit found}'; then :; else printf 'FAIL: cleanup left volumes for %s\n' "$NAME" >&2; exit 1; fi
printf 'PASS: isolated access cleanup failure coverage\n'
