#!/usr/bin/env bash
# Run the SpacetimeDB CLI against the local colony.
#
# The CLI ships inside the same image as the server, so this just forwards to the
# running container. That keeps the host free of a SpacetimeDB install and
# guarantees the CLI version always matches the server version.
#
#   scripts/stdb sql continuum "SELECT * FROM colony"
#   scripts/stdb call continuum set_time_scale 600
#   scripts/stdb logs continuum
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# </dev/null: the CLI prompts interactively when it has no TTY and would otherwise hang.
exec docker compose exec -T spacetimedb spacetime "$@" </dev/null
