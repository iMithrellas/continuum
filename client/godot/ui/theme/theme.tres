metadata/theme_tokens_json = "{
  \"version\": 1,
  \"color\": {
    \"note\": \"Graphite chrome, warm paper map. Chrome hues are reserved: accent = the player's hand, warn and critical = deviation. Everything nominal is grey.\",
    \"themes\": [
      { \"id\": \"dark\", \"name\": \"Dark\" }
    ],
    \"tokens\": [
      { \"name\": \"bg-000\", \"value\": \"#121417\", \"usage\": \"The desk: app background, the top resource bar, the viewport around the map.\" },
      { \"name\": \"bg-100\", \"value\": \"#1a1d21\", \"usage\": \"Panel body. The default ground for text.\" },
      { \"name\": \"bg-200\", \"value\": \"#22262b\", \"usage\": \"Raised inside a panel: panel headers, colonist cards, digest tiles.\" },
      { \"name\": \"bg-300\", \"value\": \"#2c3137\", \"usage\": \"Controls at rest (buttons, inputs, meter tracks) and row hover inside panels.\" },
      { \"name\": \"bg-400\", \"value\": \"#373d44\", \"usage\": \"Hover and pressed controls. Only ink and ink-muted text sit on it.\" },
      { \"name\": \"line-100\", \"value\": \"#30353b\", \"usage\": \"Hairlines: panel borders, row dividers, the top bar's cell rules. Decorative: never the only thing that separates two states.\" },
      { \"name\": \"line-200\", \"value\": \"#7a828d\", \"usage\": \"Control borders and state-tag outlines; at least 3:1 on bg-000 through bg-300.\" },
      { \"name\": \"ink\", \"value\": \"#e6e8eb\", \"usage\": \"Primary text and live values, on every bg and every -soft fill (8.9:1 or more).\" },
      { \"name\": \"ink-muted\", \"value\": \"#b0b6bd\", \"usage\": \"Secondary text: meter labels, jobs, the verbs in the log. On bg-000 to bg-400 and every -soft fill (5.3:1 or more).\" },
      { \"name\": \"ink-subtle\", \"value\": \"#969da6\", \"usage\": \"Tertiary text: section labels, timestamps, units. On bg-000 to bg-300 and every -soft fill (4.7:1 or more); never on bg-400.\" },
      { \"name\": \"meter-track\", \"value\": \"{bg-300}\", \"usage\": \"The empty part of a need or stock bar.\" },
      { \"name\": \"meter-fill\", \"value\": \"#8d959f\", \"usage\": \"A bar's fill while its value is inside the nominal band. Grey on purpose: a healthy colony is a grey colony. 4.3:1 on meter-track.\" },
      { \"name\": \"accent\", \"value\": \"#5cc6bd\", \"usage\": \"The player's hand: selection, focus, the active tab, pinned panels, player handles in the log, a running automation. As text, on bg-000 to bg-400 and accent-soft.\" },
      { \"name\": \"accent-soft\", \"value\": \"#173634\", \"usage\": \"Background of a selected row or an active toggle; text on it is ink or accent.\" },
      { \"name\": \"on-accent\", \"value\": \"#0b1a19\", \"usage\": \"Text and icons on an accent fill (the primary button).\" },
      { \"name\": \"warn\", \"value\": \"#f5c84f\", \"usage\": \"Drifting out of band: act within the shift. Always paired with the triangle glyph and a word. As text, on bg-000 to bg-400 and warn-soft. Lighter than critical (1.9:1) so the two separate without hue.\" },
      { \"name\": \"warn-soft\", \"value\": \"#36290d\", \"usage\": \"Background of a warn row or tag; text on it is ink or warn.\" },
      { \"name\": \"on-warn\", \"value\": \"#1c1305\", \"usage\": \"Marks and text on a warn fill (the triangle's exclamation).\" },
      { \"name\": \"critical\", \"value\": \"#f26a57\", \"usage\": \"Act now: starvation, collapse, fire. Always paired with the diamond glyph and a word. As text, on bg-000 to bg-200 and critical-soft only.\" },
      { \"name\": \"critical-soft\", \"value\": \"#3a1714\", \"usage\": \"Background of a critical alert row; text on it is ink, ink-muted or critical.\" },
      { \"name\": \"on-critical\", \"value\": \"#1e0806\", \"usage\": \"Marks and text on a critical fill (the diamond's exclamation, a critical button).\" },
      { \"name\": \"map-ground\", \"value\": \"#a8906a\", \"usage\": \"Open ground on the current z-level: the paper the colony is drawn on.\" },
      { \"name\": \"map-ground-deep\", \"value\": \"#7f6b4f\", \"usage\": \"Ground one z-level down seen through open tiles, and unrevealed ground.\" },
      { \"name\": \"map-grid\", \"value\": \"#8f7856\", \"usage\": \"Tile dots on map-ground. Decorative; fades out below 75% zoom.\" },
      { \"name\": \"map-ink\", \"value\": \"#231c14\", \"usage\": \"Everything written or drawn on the map: label text, region outlines, token rims, casing under accent selection. 5.5:1 on map-ground, 14.6:1 on map-paper.\" },
      { \"name\": \"map-paper\", \"value\": \"#f4eee2\", \"usage\": \"Label plates, colonist tokens, alert pins and the casing under map-plan lines; labels on the dark zones (forest, mine, sleep, dining, rec).\" },
      { \"name\": \"map-plan\", \"value\": \"#0c3a40\", \"usage\": \"Designated but not yet built: dashed outline and hatch, always cased in map-paper. 4:1 on map-ground.\" },
      { \"name\": \"zone-farm\", \"value\": \"#d8b54c\", \"usage\": \"Farming zones. Pattern: horizontal furrows. Label in map-ink (8.5:1).\" },
      { \"name\": \"zone-forest\", \"value\": \"#3e6a4b\", \"usage\": \"Forestry zones. Pattern: stipple. Label in map-paper (5.4:1).\" },
      { \"name\": \"zone-mine\", \"value\": \"#646c74\", \"usage\": \"Mining zones. Pattern: cross-hatch. Label in map-paper (4.6:1).\" },
      { \"name\": \"zone-storage\", \"value\": \"#e0d8c7\", \"usage\": \"Storage zones. Pattern: crate grid. Label in map-ink (11.9:1).\" },
      { \"name\": \"zone-sleep\", \"value\": \"#3f4a86\", \"usage\": \"Sleeping quarters. Pattern: none (solid). Label in map-paper (7.2:1).\" },
      { \"name\": \"zone-dining\", \"value\": \"#a44d2f\", \"usage\": \"Dining halls. Pattern: diagonal hatch. Label in map-paper (4.9:1).\" },
      { \"name\": \"zone-rec\", \"value\": \"#87487a\", \"usage\": \"Recreation. Pattern: vertical rule. Label in map-paper (5.6:1).\" }
    ]
  },
  \"type\": {
    \"fonts\": [
      { \"family\": \"IBM Plex Sans\", \"file\": \"fonts/IBMPlexSans-Regular.woff2\", \"weight\": \"400\" },
      { \"family\": \"IBM Plex Sans\", \"file\": \"fonts/IBMPlexSans-Medium.woff2\", \"weight\": \"500\" },
      { \"family\": \"IBM Plex Sans\", \"file\": \"fonts/IBMPlexSans-SemiBold.woff2\", \"weight\": \"600\" },
      { \"family\": \"IBM Plex Sans Condensed\", \"file\": \"fonts/IBMPlexSansCondensed-Medium.woff2\", \"weight\": \"500\" },
      { \"family\": \"IBM Plex Sans Condensed\", \"file\": \"fonts/IBMPlexSansCondensed-SemiBold.woff2\", \"weight\": \"600\" },
      { \"family\": \"IBM Plex Mono\", \"file\": \"fonts/IBMPlexMono-Regular.woff2\", \"weight\": \"400\" },
      { \"family\": \"IBM Plex Mono\", \"file\": \"fonts/IBMPlexMono-Medium.woff2\", \"weight\": \"500\" }
    ],
    \"families\": {
      \"sans\": \"\\\"IBM Plex Sans\\\", system-ui, sans-serif\",
      \"cond\": \"\\\"IBM Plex Sans Condensed\\\", \\\"IBM Plex Sans\\\", system-ui, sans-serif\",
      \"mono\": \"\\\"IBM Plex Mono\\\", ui-monospace, monospace\"
    },
    \"groups\": [
      {
        \"name\": \"Interface\",
        \"family\": \"sans\",
        \"note\": \"Plex Sans for anything read as a sentence or a name.\",
        \"styles\": [
          { \"name\": \"title\", \"fontSize\": \"16px\", \"lineHeight\": \"20px\", \"fontWeight\": 600, \"sample\": \"Colonist roster\", \"usage\": \"Digest and dialog titles; panel titles use body-strong.\" },
          { \"name\": \"body-strong\", \"fontSize\": \"13px\", \"lineHeight\": \"18px\", \"fontWeight\": 600, \"sample\": \"Bram is exhausted\", \"usage\": \"Panel titles, colonist names, alert titles.\" },
          { \"name\": \"body\", \"fontSize\": \"13px\", \"lineHeight\": \"18px\", \"fontWeight\": 400, \"sample\": \"Farming · produce and haul\", \"usage\": \"Default interface text.\" },
          { \"name\": \"small\", \"fontSize\": \"12px\", \"lineHeight\": \"16px\", \"fontWeight\": 400, \"sample\": \"Cargo: 12 wood, bound for storage\", \"usage\": \"Secondary lines, alert details, meter labels.\" }
        ]
      },
      {
        \"name\": \"Labels\",
        \"family\": \"cond\",
        \"note\": \"Plex Sans Condensed for labels that must fit: set section, tag and plate in uppercase.\",
        \"styles\": [
          { \"name\": \"display\", \"fontSize\": \"28px\", \"lineHeight\": \"32px\", \"fontWeight\": 600, \"letterSpacing\": \"-0.01em\", \"sample\": \"Since you left\", \"usage\": \"One per screen at most: the digest headline, a colony name.\" },
          { \"name\": \"section\", \"fontSize\": \"11px\", \"lineHeight\": \"14px\", \"fontWeight\": 600, \"letterSpacing\": \"0.08em\", \"sample\": \"NEEDS · ASSIGNMENTS · CARGO\", \"usage\": \"Section labels inside panels and resource names in the top bar, uppercase, in ink-subtle.\" },
          { \"name\": \"tag\", \"fontSize\": \"11px\", \"lineHeight\": \"14px\", \"fontWeight\": 500, \"letterSpacing\": \"0.04em\", \"sample\": \"WORKING\", \"usage\": \"Colonist state tags and map label plates, uppercase.\" }
        ]
      },
      {
        \"name\": \"Readouts\",
        \"family\": \"mono\",
        \"note\": \"Plex Mono for every number that updates, so digits never jitter.\",
        \"styles\": [
          { \"name\": \"readout-lg\", \"fontSize\": \"18px\", \"lineHeight\": \"22px\", \"fontWeight\": 500, \"sample\": \"490\", \"usage\": \"Resource values in the top bar.\" },
          { \"name\": \"readout\", \"fontSize\": \"12px\", \"lineHeight\": \"16px\", \"fontWeight\": 500, \"sample\": \"62 ↘ −3/h\", \"usage\": \"Meter values, rates, counts in panels.\" },
          { \"name\": \"log\", \"fontSize\": \"12px\", \"lineHeight\": \"16px\", \"fontWeight\": 400, \"sample\": \"d1 14:47\", \"usage\": \"Timestamps and durations in the activity log and alerts, in ink-subtle.\" }
        ]
      }
    ]
  },
  \"spacing\": {
    \"note\": \"4px base. Panels pad space-3; rows gap space-2.\",
    \"tokens\": [
      { \"name\": \"space-1\", \"value\": \"4px\", \"usage\": \"Glyph to label; tag padding.\" },
      { \"name\": \"space-2\", \"value\": \"8px\", \"usage\": \"Between columns in a row; between meters.\" },
      { \"name\": \"space-3\", \"value\": \"12px\", \"usage\": \"Panel padding; between groups inside a panel.\" },
      { \"name\": \"space-4\", \"value\": \"16px\", \"usage\": \"Between docked panels; around the map viewport.\" },
      { \"name\": \"space-6\", \"value\": \"24px\", \"usage\": \"Between sections of the away digest.\" },
      { \"name\": \"space-8\", \"value\": \"32px\", \"usage\": \"Margins of full-screen views (digest, settings).\" }
    ]
  },
  \"size\": {
    \"note\": \"Fixed sizes at 100% UI scale.\",
    \"tokens\": [
      { \"name\": \"control-sm\", \"value\": \"24px\", \"usage\": \"Icon buttons in panel headers; compact roster rows.\" },
      { \"name\": \"control-md\", \"value\": \"28px\", \"usage\": \"Buttons, tabs, inputs, alert and log rows at minimum.\" },
      { \"name\": \"panel-header\", \"value\": \"32px\", \"usage\": \"Panel header and the workspace tab bar.\" },
      { \"name\": \"topbar\", \"value\": \"40px\", \"usage\": \"The resource bar along the top edge.\" },
      { \"name\": \"tile\", \"value\": \"16px\", \"usage\": \"One map tile at 100% zoom; zoom steps are whole multiples up to 400%.\" },
      { \"name\": \"panel-min\", \"value\": \"280px\", \"usage\": \"Narrowest a docked panel may get.\" }
    ]
  },
  \"radius\": {
    \"note\": \"Machined, not soft. Map tiles are always square.\",
    \"tokens\": [
      { \"name\": \"radius-0\", \"value\": \"0\", \"usage\": \"Map tiles and zone regions, the top bar.\" },
      { \"name\": \"radius-sm\", \"value\": \"2px\", \"usage\": \"Buttons, tags, meter tracks, label plates.\" },
      { \"name\": \"radius-md\", \"value\": \"4px\", \"usage\": \"Panels and cards.\" }
    ]
  },
  \"shadow\": {
    \"note\": \"Docked panels have no shadow; separation is hairlines. Only floating things cast one.\",
    \"tokens\": [
      { \"name\": \"shadow-float\", \"value\": \"0 2px 6px #00000066, 0 10px 28px #000000a6\", \"usage\": \"Undocked panels, menus, tooltips: anything floating over the map.\" },
      { \"name\": \"focus-ring\", \"value\": \"0 0 0 1px #121417, 0 0 0 3px #5cc6bd\", \"usage\": \"Keyboard and gamepad focus: a 1px desk gap, then 2px of solid accent (5.3:1 or more on every bg).\" }
    ]
  }
}
"
